# Copy to .env and fill in the keys for the backends you enabled in config.yaml.
# Only the ones matching an enabled backend are actually required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shared key: webui authenticates to llm-gateway with it, llm-gateway accepts
# it as its admin/master key. Fine for single-user local use; replace with a
# real secret before exposing this beyond localhost.
LITELLM_MASTER_KEY=sk-change-me
