services:
  webui:
    image: {{ webui_image }}
    depends_on:
{% if isabelle_enabled %}
      - agent
{% else %}
      - llm-gateway
{% endif %}
    environment:
      # NOTE: verify this env var against the Open WebUI version you pin -
      # it has been renamed across releases (singular vs. OPENAI_API_BASE_URLS).
{% if isabelle_enabled %}
      # The agent (not llm-gateway) is in the loop when Isabelle is enabled -
      # it runs with network_mode: "service:isabelle" (see isabelle/README.md
      # and design doc §2), so it has no network identity of its own and is
      # only reachable at the *isabelle* service's hostname.
{% endif %}
      OPENAI_API_BASE_URL: {{ api_base }}
      OPENAI_API_KEY: ${LITELLM_MASTER_KEY}
    ports:
      - "8080:8080"
    volumes:
      - webui-data:/app/backend/data
    restart: unless-stopped

  llm-gateway:
    image: {{ litellm_image }}
    command: ["--config", "/app/config.yaml"]
    env_file:
      - .env
    environment:
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
    volumes:
      - ./litellm-config.yaml:/app/config.yaml:ro
    ports:
      - "4000:4000"
    restart: unless-stopped
{% if ollama_enabled %}

  ollama:
    image: {{ ollama_image }}
    volumes:
      - ollama-data:/root/.ollama
    restart: unless-stopped
{% endif %}

  cli:
    # Optional terminal agent client (https://opencode.ai), talking to the
    # same OpenAI-compatible endpoint as webui. Not started by `up` - needs
    # a TTY: `docker compose --profile cli run --rm cli`.
    image: ghcr.io/anomalyco/opencode:latest
    profiles: ["cli"]
    depends_on:
{% if isabelle_enabled %}
      - agent
{% else %}
      - llm-gateway
{% endif %}
    environment:
      OPENCODE_API_KEY: ${LITELLM_MASTER_KEY}
      # Points at an explicit path instead of relying on the image's $HOME
      # (the official ghcr.io/anomalyco/opencode image runs as root, but
      # that's an implementation detail, not a documented contract).
      OPENCODE_CONFIG: /opencode.json
    volumes:
      - ./opencode.json:/opencode.json:ro
    stdin_open: true
    tty: true
{% if isabelle_enabled %}

  isabelle:
    # docker build -t isabelle-afp isabelle/ (see isabelle/README.md)
    image: isabelle-afp
    volumes:
      - isabelle-afp-user-heaplog:/home/isabelle/.isabelle/heaps/polyml-5.9.2_x86_64_32-linux/log
      - isabelle-afp-dist-heaplog:/home/isabelle/Isabelle/heaps/polyml-5.9.2_x86_64_32-linux/log
      - isabelle-server-info:/home/isabelle/server-info
      - isabelle-workspace:/isabelle-workspace
    restart: unless-stopped

  agent:
    # docker build -t ai-math-container-agent -f agent/Dockerfile . (see README.md)
    image: ai-math-container-agent
    network_mode: "service:isabelle"
    depends_on:
      - isabelle
      - llm-gateway
    env_file:
      - .env
    environment:
      LITELLM_BASE_URL: http://llm-gateway:4000/v1
      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
      ISABELLE_SERVER_INFO_PATH: /isabelle-server-info/registration.log
      ISABELLE_WORKSPACE_DIR: /isabelle-workspace
      AGENT_DATA_DIR: /data
    volumes:
      - isabelle-server-info:/isabelle-server-info:ro
      - isabelle-workspace:/isabelle-workspace
      - agent-data:/data
    restart: unless-stopped
{% endif %}

volumes:
  webui-data:
{% if ollama_enabled %}
  ollama-data:
{% endif %}
{% if isabelle_enabled %}
  isabelle-afp-user-heaplog:
  isabelle-afp-dist-heaplog:
  isabelle-server-info:
  isabelle-workspace:
  agent-data:
{% endif %}
